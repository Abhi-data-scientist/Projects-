# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=voice_sql_assistant

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Faster-Whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Piper TTS
PIPER_MODEL_PATH=models/en_US-lessac-medium.onnx
PIPER_EXECUTABLE=piper

# Folders
AUDIO_DIR=audio
LOGS_DIR=logs

MAX_SQL_ROWS=200

# Redis cache (optional)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
REDIS_CONNECT_TIMEOUT=0.2
SQL_CACHE_TTL_SECONDS=60
GENERAL_CACHE_TTL_SECONDS=3600
REDIS_RETRY_COOLDOWN_SECONDS=60

# Keep local chat responsive when external providers are slow/unavailable.
ENABLE_LLM=false
ENABLE_TTS=false

# Twilio WhatsApp (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio Sandbox: whatsapp:+14155238886, or your approved sender number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
