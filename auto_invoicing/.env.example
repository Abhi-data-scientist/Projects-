# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=auto_invoicing

# Business
DEFAULT_TAX_RATE=18
COMPANY_NAME=Your Company Pvt Ltd
COMPANY_ADDRESS=Jaipur, Rajasthan, India
COMPANY_GSTIN=

# Behavior
# true = missing fields pe 422 error | false = best-effort invoice generate karega
STRICT_VALIDATION=true

# Optional but recommended for local NLP Named Entity Recognition (customer/company names)
# After pip install, run: python -m spacy download en_core_web_sm
