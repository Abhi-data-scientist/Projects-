# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model routing (cost-friendly defaults).
# 8B instant model for light/structured tasks, 70B versatile only where reasoning quality matters.
GROQ_MODEL_LIGHT=openai/gpt-oss-20b
GROQ_MODEL_HEAVY=openai/gpt-oss-120b

# Max tokens per agent call (kept tight to control cost)
MAX_TOKENS_LIGHT=4096
MAX_TOKENS_HEAVY=2048
MAX_TOKENS_CODING=8192
MAX_TOKENS_BUG_FIX=8192
MAX_TOKENS_JSON_RETRY=8192

# CORS - comma separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5500
